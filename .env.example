# Copy to .env (0600) or let scripts/install.sh write it. This repository is public:
# no real value belongs in this file or anywhere else in git. tests/test_secrets.py
# fails if a value from your local .env turns up in a tracked file.

# Gate on registration and on credentials. Announced in the room.
LAB_PASSPHRASE=
# Admin page.
ADMIN_PASSWORD=

# Shown to a registered participant, never in page source. Base URL ends in /v1.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Galileo. The admin token is NOT here on purpose: it is armed from the admin page and
# held in memory only, so a snapshot of the box carries no Galileo credential.
GALILEO_API_URL=https://api.multitenant.galileocloud.io
GALILEO_CONSOLE_URL=https://console.multitenant.galileocloud.io
GALILEO_AGENT_CONTROL_URL=https://agent-control.multitenant.galileocloud.io
# The password every created Galileo account gets.
GALILEO_USER_PASSWORD=
GALILEO_DEFAULT_ROLE=user

# Bank app logins, the same on every participant instance.
BANK_ACCOUNT=12345678
BANK_PASSWORD=AlexDemo1234!
PRESENTER_PASSWORD=PresenterDemo1234!

# Optional line under the overview headline.
EVENT_DATE=
EVENT_PLACE=

# Refuse to create more than this many Galileo accounts, whatever the roster says.
ACCOUNT_CAP=130
# 1 keeps the Galileo worker offline and invents account names, for local tweaking.
DRY_RUN=0

SESSION_SECRET=
PORT=8099
